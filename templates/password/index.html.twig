{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe - Gestion des accès{% endblock %}

{% block body %}

	<div class="page-inscription">

		<div class="inscription-card">

			<div class="inscription-header">

				<div class="projet-title">
					<img src="{{ asset('images/logo.svg') }}" alt="" width="28" height="28">
					Gestion des accès
				</div>

				<h1 class="inscription-title">Changer mon mot de passe</h1>

				<p class="inscription-description">
					Connecté en tant que {{ app.user.userIdentifier }}.
					Vous ne pouvez pas réutiliser vos derniers mots de passe.
				</p>

			</div>

			<div class="inscription-form">

				{% for message in app.flashes('success') %}
					<div class="alert alert-success">{{ message }}</div>
				{% endfor %}

				{{ form_start(passwordForm) }}

				{{ form_row(passwordForm.currentPassword) }}
				{{ form_row(passwordForm.plainPassword.first) }}
				{{ form_row(passwordForm.plainPassword.second) }}

				<button type="submit" class="bouton-inscription">
					Modifier mon mot de passe
				</button>

				{{ form_end(passwordForm) }}

				<div class="info-securite">
					<a href="{{ path('app_logout') }}">Se déconnecter</a>
				</div>

			</div>

		</div>

	</div>

{% endblock %}
