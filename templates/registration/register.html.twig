{% extends 'base.html.twig' %}

{% block title %}Inscription - Gestion des accès
{% endblock %}

{% block body %}

	<div class="page-inscription">

		<div class="inscription-card">

			<div class="inscription-header">

				<div class="projet-title">
					<img src="{{ asset('images/logo.svg') }}" alt="" width="28" height="28">
					Gestion des accès
				</div>

				<h1 class="inscription-title">Créer un compte</h1>

				<p class="inscription-description">
					Renseignez vos informations pour créer votre compte.
				</p>

			</div>

			<div class="inscription-form">

				{{ form_start(registrationForm) }}

				{# Ligne 1 : Nom | Prénom #}
				<div class="row">
					<div class="col-md-6">
						{{ form_row(registrationForm.nom) }}
					</div>
					<div class="col-md-6">
						{{ form_row(registrationForm.prenom) }}
					</div>
				</div>

				{# Ligne 2 : Adresse #}
				{{ form_row(registrationForm.adresse) }}

				{# Ligne 3 : Ville | Code postal (mêmes colonnes que Nom | Prénom) #}
				<div class="row">
					<div class="col-md-6">
						{{ form_row(registrationForm.ville) }}
					</div>
					<div class="col-md-6">
						{{ form_row(registrationForm.codePostal) }}
					</div>
				</div>

				{# Email #}
				{{ form_row(registrationForm.email) }}

				{# Mot de passe #}
				{{ form_row(registrationForm.plainPassword.first) }}
				{{ form_row(registrationForm.plainPassword.second) }}

				<button type="submit" class="bouton-inscription">
					Créer mon compte
				</button>

				{{ form_end(registrationForm) }}

				<div class="info-securite">
					Vos informations sont utilisées uniquement pour la gestion de votre compte.
				</div>

			</div>

		</div>

	</div>

{% endblock %}
