{% extends 'base.html.twig' %}

{% block title %}Mon profil - Gestion des accès{% endblock %}

{% block body %}

	<div class="container py-5">

		<h1 class="h3 mb-1">{{ app.user.prenom }} {{ app.user.nom }}</h1>
		<p class="text-muted mb-4">Voici les informations de votre compte.</p>

		{% for message in app.flashes('success') %}
			<div class="alert alert-success">{{ message }}</div>
		{% endfor %}

		<div class="row g-3">

			<div class="col-lg-6">
				<div class="card h-100">
					<div class="card-body">
						<h2 class="h5 mb-3">Identité</h2>
						<dl class="row mb-0">
							<dt class="col-sm-4">Nom</dt>
							<dd class="col-sm-8">{{ app.user.nom }}</dd>

							<dt class="col-sm-4">Prénom</dt>
							<dd class="col-sm-8">{{ app.user.prenom }}</dd>

							<dt class="col-sm-4">Email</dt>
							<dd class="col-sm-8">{{ app.user.email }}</dd>

							<dt class="col-sm-4">Rôle</dt>
							<dd class="col-sm-8 mb-0">
								{% if is_granted('ROLE_ADMIN') %}
									<span class="badge bg-primary">Administrateur</span>
								{% else %}
									<span class="badge bg-secondary">Utilisateur</span>
								{% endif %}
							</dd>
						</dl>
					</div>
				</div>
			</div>

			<div class="col-lg-6">
				<div class="card h-100">
					<div class="card-body">
						<h2 class="h5 mb-3">Adresse</h2>
						<dl class="row mb-0">
							<dt class="col-sm-4">Adresse</dt>
							<dd class="col-sm-8">{{ app.user.adresse }}</dd>

							<dt class="col-sm-4">Code postal</dt>
							<dd class="col-sm-8">{{ app.user.codePostal }}</dd>

							<dt class="col-sm-4">Ville</dt>
							<dd class="col-sm-8 mb-0">{{ app.user.ville }}</dd>
						</dl>
					</div>
				</div>
			</div>

			<div class="col-12">
				<div class="card">
					<div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center">
						<div class="mb-3 mb-md-0">
							<h2 class="h5">Sécurité</h2>
							<p class="text-muted mb-0">Modifiez votre mot de passe. Vous ne pouvez pas réutiliser vos derniers mots de passe.</p>
						</div>
						<a href="{{ path('app_password') }}" class="btn btn-primary">Modifier mon mot de passe</a>
					</div>
				</div>
			</div>

		</div>

	</div>

{% endblock %}
