{% extends 'base.html.twig' %}

{% block title %}{{ title }} - Gestion des accès{% endblock %}

{% block body %}

	<div class="container py-5" style="max-width: 700px;">

		<h1 class="h3 mb-4">{{ title }}</h1>

		{% for message in app.flashes('danger') %}
			<div class="alert alert-danger">{{ message }}</div>
		{% endfor %}

		{{ form_start(form) }}

		<div class="row">
			<div class="col-md-6">{{ form_row(form.nom) }}</div>
			<div class="col-md-6">{{ form_row(form.prenom) }}</div>
		</div>

		{{ form_row(form.adresse) }}

		<div class="row">
			<div class="col-md-6">{{ form_row(form.ville) }}</div>
			<div class="col-md-6">{{ form_row(form.codePostal) }}</div>
		</div>

		{{ form_row(form.email) }}

		{% if form.plainPassword is defined %}
			{{ form_row(form.plainPassword.first) }}
			{{ form_row(form.plainPassword.second) }}
		{% endif %}

		{{ form_row(form.roles) }}

		<button type="submit" class="btn btn-primary">Enregistrer</button>
		<a href="{{ path('app_admin') }}" class="btn btn-outline-secondary">Annuler</a>

		{{ form_end(form) }}

	</div>

{% endblock %}
