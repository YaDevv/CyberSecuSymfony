{% extends 'base.html.twig' %}

{% block title %}Administration - Gestion des accès{% endblock %}

{% block body %}

	<div class="container py-5">

		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1 class="h3 mb-0">Gestion des utilisateurs</h1>
			<div>
				<a href="{{ path('app_admin_user_new') }}" class="btn btn-primary">Ajouter un utilisateur</a>
				<a href="{{ path('app_logout') }}" class="btn btn-outline-secondary">Se déconnecter</a>
			</div>
		</div>

		{% for type in ['success', 'danger'] %}
			{% for message in app.flashes(type) %}
				<div class="alert alert-{{ type }}">{{ message }}</div>
			{% endfor %}
		{% endfor %}

		<div class="table-responsive">
			<table class="table table-hover align-middle">
				<thead>
					<tr>
						<th>Nom</th>
						<th>Email</th>
						<th>Rôles</th>
						<th>Statut</th>
						<th>Connexions</th>
						<th class="text-end">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for user in users %}
						{% set history = logins[user.id] ?? [] %}
						<tr>
							<td>{{ user.prenom }} {{ user.nom }}</td>
							<td>{{ user.email }}</td>
							<td>{{ user.roles|join(', ') }}</td>
							<td>
								{% if user.suspended %}
									<span class="badge bg-danger">Suspendu</span>
								{% else %}
									<span class="badge bg-success">Actif</span>
								{% endif %}
							</td>
							<td>
								{% if history|length > 0 %}
									<details>
										<summary>{{ history|length }} connexion(s)</summary>
										<ul class="list-unstyled mb-0 mt-2 small">
											{% for login in history %}
												<li>{{ login.connectedAt|date('d/m/Y à H:i:s') }}</li>
											{% endfor %}
										</ul>
									</details>
								{% else %}
									<span class="text-muted">Aucune</span>
								{% endif %}
							</td>
							<td class="text-end text-nowrap">
								<a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>

								<form method="post" action="{{ path('app_admin_user_suspend', {id: user.id}) }}" class="d-inline">
									<input type="hidden" name="_token" value="{{ csrf_token('suspend' ~ user.id) }}">
									<button type="submit" class="btn btn-sm btn-outline-warning">
										{{ user.suspended ? 'Réactiver' : 'Suspendre' }}
									</button>
								</form>

								<form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer définitivement cet utilisateur ?');">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
									<button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
								</form>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-muted">Aucun utilisateur.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

	</div>

{% endblock %}
