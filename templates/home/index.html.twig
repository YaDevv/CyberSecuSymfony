{% extends 'base.html.twig' %}

{% block title %}Accueil - Gestion des accès{% endblock %}

{% block body %}

	<div class="container py-5">

		{% if is_granted('ROLE_USER') %}

			<h1 class="h3 mb-1">Bonjour {{ app.user.prenom }} {{ app.user.nom }}</h1>
			<p class="text-muted mb-4">Que souhaitez-vous faire ?</p>

			<div class="row g-3">

				<div class="col-md-6 col-lg-4">
					<div class="card h-100">
						<div class="card-body d-flex flex-column">
							<h2 class="h5">Mon profil</h2>
							<p class="text-muted">Consulter vos informations et modifier votre mot de passe.</p>
							<a href="{{ path('app_profile') }}" class="btn btn-primary mt-auto">Voir mon profil</a>
						</div>
					</div>
				</div>

				{% if is_granted('ROLE_ADMIN') %}
					<div class="col-md-6 col-lg-4">
						<div class="card h-100">
							<div class="card-body d-flex flex-column">
								<h2 class="h5">Utilisateurs</h2>
								<p class="text-muted">Consulter les comptes, leurs rôles et l'historique des connexions. Suspendre ou supprimer un compte.</p>
								<a href="{{ path('app_admin') }}" class="btn btn-primary mt-auto">Gérer les utilisateurs</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-4">
						<div class="card h-100">
							<div class="card-body d-flex flex-column">
								<h2 class="h5">Nouvel utilisateur</h2>
								<p class="text-muted">Créer un compte et lui attribuer un rôle.</p>
								<a href="{{ path('app_admin_user_new') }}" class="btn btn-primary mt-auto">Ajouter un utilisateur</a>
							</div>
						</div>
					</div>
				{% endif %}

				<div class="col-md-6 col-lg-4">
					<div class="card h-100">
						<div class="card-body d-flex flex-column">
							<h2 class="h5">Session</h2>
							<p class="text-muted">Quitter votre session en toute sécurité.</p>
							<a href="{{ path('app_logout') }}" class="btn btn-outline-secondary mt-auto">Se déconnecter</a>
						</div>
					</div>
				</div>

			</div>

		{% else %}

			<div class="text-center py-5">
				<h1 class="h3 mb-3">Gestion des accès</h1>
				<p class="text-muted mb-4">Connectez-vous ou créez un compte pour continuer.</p>
				<a href="{{ path('app_login') }}" class="btn btn-primary me-2">Se connecter</a>
				<a href="{{ path('app_register') }}" class="btn btn-outline-primary">Créer un compte</a>
			</div>

		{% endif %}

	</div>

{% endblock %}
