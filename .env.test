# Environnement de TEST (chargé automatiquement quand APP_ENV=test).
# Ce fichier est versionné : il ne contient aucun secret.
# IMPORTANT : .env.local n'est PAS lu en environnement test, donc les tests
# n'utilisent jamais la base de données du développement ni celle du serveur de test.

KERNEL_CLASS='App\Kernel'
APP_SECRET='secret-uniquement-pour-les-tests'
SYMFONY_DEPRECATIONS_HELPER=disabled

# Base de données dédiée aux tests : fichier SQLite jetable (var/test.db).
# Aucun serveur MySQL n'est nécessaire, et la base est recréée avant chaque test.
# Pour utiliser MySQL/MariaDB à la place, créer un fichier .env.test.local (non versionné)
# avec par exemple : DATABASE_URL="mysql://user:mdp@127.0.0.1:3306/ma_base_test?serverVersion=10.11.14-MariaDB&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
